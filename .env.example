HTTP_ADDR=127.0.0.1:8080
MYSQL_DSN=feed_app:replace-me@tcp(127.0.0.1:3308)/go_feed_system?charset=utf8mb4&parseTime=True&loc=Local
JWT_SECRET=replace-with-at-least-32-random-bytes
LOCAL_STORAGE_DIR=./data/videos
REDIS_ADDR=127.0.0.1:6380
REDIS_PASSWORD=replace-me
REDIS_DB=0
OUTBOX_PUBLISH_INTERVAL=1s
RABBITMQ_URL=amqp://feed_app:replace-me@127.0.0.1:5672/
RABBITMQ_EXCHANGE=feed.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_ROUTING_KEY=video.published
RABBITMQ_QUEUE=feed.fanout.video.published
RABBITMQ_DLX=feed.dlx
RABBITMQ_DLQ=feed.fanout.video.published.dlq
RABBITMQ_RETRY_EXCHANGE=feed.retry
RABBITMQ_RETRY_QUEUE=feed.fanout.video.published.retry
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY=5s
FEED_FANOUT_FOLLOWER_THRESHOLD=1000
FEED_BIG_AUTHOR_CACHE_TTL=60s
